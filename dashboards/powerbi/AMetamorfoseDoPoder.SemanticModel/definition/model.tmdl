model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["eleicoes", "candidatos", "votos_distrito", "camara", "vereadores_eleitos", "campanha_digital", "secoes"]
annotation __PBI_TimeIntelligenceEnabled = 0

ref table eleicoes
ref table candidatos
ref table votos_distrito
ref table camara
ref table vereadores_eleitos
ref table campanha_digital
ref table secoes
